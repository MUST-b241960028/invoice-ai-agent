{
  "name": "AI Invoice Processing Agent",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "📂 Invoice Input",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [240, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{ $json.fileType }}", "operation": "equals", "value2": "pdf" }]
        }
      },
      "id": "split",
      "name": "📄 File Type?",
      "type": "n8n-nodes-base.if",
      "position": [460, 400]
    },
    {
      "parameters": {
        "jsCode": "// PyMuPDF: render PDF page to PNG at 200 DPI\n// fitz.open(filepath) → page.get_pixmap(dpi=200) → base64 PNG\nreturn [{ json: { ...items[0].json, imageData: 'base64_png', mediaType: 'image/png' } }];"
      },
      "id": "pdf_render",
      "name": "🔧 PyMuPDF\nRender PDF → PNG",
      "type": "n8n-nodes-base.code",
      "position": [680, 280]
    },
    {
      "parameters": {
        "jsCode": "// Direct load JPG/PNG → base64\nreturn [{ json: { ...items[0].json, imageData: 'base64_img', mediaType: items[0].json.fileType === 'png' ? 'image/png' : 'image/jpeg' } }];"
      },
      "id": "img_load",
      "name": "🖼️ Load Image\nBase64 Encode",
      "type": "n8n-nodes-base.code",
      "position": [680, 520]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "claude-sonnet-4-20250514" },
            { "name": "max_tokens", "value": "2000" }
          ]
        }
      },
      "id": "claude_vision",
      "name": "🤖 Claude Sonnet 4\nVision Extraction",
      "type": "n8n-nodes-base.httpRequest",
      "position": [900, 400]
    },
    {
      "parameters": {
        "jsCode": "const extracted = JSON.parse(items[0].json.body.content[0].text);\n// Returns: invoice_number, vendor_name, bank_name, account_number,\n//          invoice_date, due_date, line_items[], grand_total\nreturn [{ json: extracted }];"
      },
      "id": "parse_json",
      "name": "📋 Parse\nStructured JSON",
      "type": "n8n-nodes-base.code",
      "position": [1120, 400]
    },
    {
      "parameters": {
        "jsCode": "const d = items[0].json;\nconst issues = [];\nconst reasoning = {};\n\n// 1. AMOUNT MISMATCH\nconst lineSum = (d.line_items||[]).reduce((s,l) => s+(l.total||0), 0);\nconst grandTotal = d.grand_total || 0;\nreasoning.amount_check = { line_sum: lineSum, grand_total: grandTotal, passed: lineSum === grandTotal || lineSum === 0 };\nif (lineSum && grandTotal && lineSum !== grandTotal) issues.push({ type: 'AMOUNT_MISMATCH', detail: `Sum ${lineSum} ≠ grand total ${grandTotal}` });\n\n// 2. DATE CHECK\nconst invDate = d.invoice_date ? new Date(d.invoice_date) : null;\nconst dueDate = d.due_date ? new Date(d.due_date) : null;\nconst dateOk = (!invDate || !isNaN(invDate)) && (!dueDate || !dueDate < invDate);\nreasoning.date_check = { invoice_date: d.invoice_date, due_date: d.due_date, passed: dateOk };\nif (!dateOk) issues.push({ type: 'INVALID_DATE', detail: 'Invalid or illogical date' });\n\nreturn [{ json: { ...d, issues, reasoning } }];"
      },
      "id": "validate",
      "name": "⚙️ Validation Engine\n5 Checks",
      "type": "n8n-nodes-base.code",
      "position": [1340, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT Name, Bank, Account FROM Vendors;\nSELECT * FROM Invoices WHERE VendorName = '{{ $json.vendor_name }}' LIMIT 10;"
      },
      "id": "db_lookup",
      "name": "🗄️ Master DB Lookup\nVendors + History",
      "type": "n8n-nodes-base.sqlite",
      "position": [1340, 600]
    },
    {
      "parameters": {
        "jsCode": "const inv = items[0].json;\nconst issues = inv.issues || [];\nconst keyFields = ['vendor_name','invoice_date','grand_total','account_number','bank_name'];\nconst missing = keyFields.filter(f => !inv[f]).length;\nconst confidence = Math.max(0.1, Math.min(1.0, 1.0 - missing * 0.15 - (!inv.line_items?.length ? 0.2 : 0)));\n\nconst denyTypes = new Set(['AMOUNT_MISMATCH','INVALID_DATE','BANK_ACCOUNT_MISMATCH','DUPLICATE','UNREGISTERED_VENDOR']);\nconst hasDeny = issues.some(i => denyTypes.has(i.type));\n\nlet decision;\nif (hasDeny) decision = 'DENY';\nelse if (confidence < 0.6) decision = 'HUMAN_APPROVAL';\nelse decision = 'AUTO_POST';\n\nreturn [{ json: { ...inv, confidence: Math.round(confidence * 100) / 100, decision } }];"
      },
      "id": "decision",
      "name": "⚖️ Decision Engine\nconfidence + issues",
      "type": "n8n-nodes-base.code",
      "position": [1560, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{ $json.decision }}", "operation": "equals", "value2": "DENY" }]
        }
      },
      "id": "route",
      "name": "🔀 Route Decision",
      "type": "n8n-nodes-base.switch",
      "position": [1780, 400]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...items[0].json, status: 'DENIED', color: 'red' } }];"
      },
      "id": "deny",
      "name": "❌ DENY\nLog + Alert",
      "type": "n8n-nodes-base.code",
      "position": [2000, 240]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...items[0].json, status: 'PENDING_REVIEW', color: 'orange' } }];"
      },
      "id": "human",
      "name": "⚠️ HUMAN APPROVAL\nReview Queue",
      "type": "n8n-nodes-base.code",
      "position": [2000, 400]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...items[0].json, status: 'POSTED', color: 'green' } }];"
      },
      "id": "auto",
      "name": "✅ AUTO POST\nERP System",
      "type": "n8n-nodes-base.code",
      "position": [2000, 560]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "claude-sonnet-4-20250514" },
            { "name": "max_tokens", "value": "800" }
          ]
        }
      },
      "id": "qa",
      "name": "💬 Q&A Agent\nClaude Analytics",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2220, 400]
    }
  ],
  "connections": {
