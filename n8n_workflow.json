    "❌ DENY\nLog + Alert":           { "main": [[{ "node": "💬 Q&A Agent\nClaude Analytics", "type": "main", "index": 0 }]] },
    "⚠️ HUMAN APPROVAL\nReview Queue":{ "main": [[{ "node": "💬 Q&A Agent\nClaude Analytics", "type": "main", "index": 0 }]] },
    "✅ AUTO POST\nERP System":        { "main": [[{ "node": "💬 Q&A Agent\nClaude Analytics", "type": "main", "index": 0 }]] }
  },
